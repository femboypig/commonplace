--- a/stdlib/FreeBSD/abort.c
+++ b/stdlib/FreeBSD/abort.c
@@ -40,12 +40,17 @@
 #include <stddef.h>
 #include <unistd.h>
 #include <pthread.h>
-#include <pthread_workqueue.h>
+#include <pthread/workqueue_private.h>
 #include "un-namespace.h"
 
 #include "libc_private.h"
 
+#if __has_include(<CrashReporterClient.h>)
 #include <CrashReporterClient.h>
+#define HAVE_CRASH_REPORTER 1
+#else
+#define HAVE_CRASH_REPORTER 0
+#endif
 #include "_simple.h"
 
 extern void (*__cleanup)();
@@ -58,8 +63,10 @@
 {
 	struct sigaction act;
 
+#if HAVE_CRASH_REPORTER
 	if (!CRGetCrashLogMessage())
 		CRSetCrashLogMessage("abort() called");
+#endif
 
 	/*
 	 * POSIX requires we flush stdio buffers on abort.
@@ -104,8 +111,10 @@
 {
 	struct sigaction act;
 
+#if HAVE_CRASH_REPORTER
 	if (!CRGetCrashLogMessage())
 		CRSetCrashLogMessage("__abort() called");
+#endif
 	act.sa_handler = SIG_DFL;
 	act.sa_flags = 0;
 	sigfillset(&act.sa_mask);
@@ -143,6 +152,7 @@
 void
 abort_report_np(const char *fmt, ...)
 {
+#if HAVE_CRASH_REPORTER
 	_SIMPLE_STRING s;
 	va_list ap;
 
@@ -153,5 +163,11 @@
 		CRSetCrashLogMessage(_simple_string(s));
 	} else
 		CRSetCrashLogMessage(fmt); /* the format string is better than nothing */
+#else
+	va_list ap;
+	va_start(ap, fmt);
+	_simple_vdprintf(STDERR_FILENO, fmt, ap);
+	va_end(ap);
+#endif
 	abort();
 }
