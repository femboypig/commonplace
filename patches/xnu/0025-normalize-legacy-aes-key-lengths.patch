+/* The legacy kernel API accepts bytes or bits; ccmode accepts bytes. */
+static int aes_key_bytes(int length)
+{
+    if (length == 128 || length == 192 || length == 256)
+        length /= 8;
+    return length == 16 || length == 24 || length == 32 ? length : 0;
+}
