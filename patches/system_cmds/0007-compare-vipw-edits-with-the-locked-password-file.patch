+/* Compare the edited contents: HFS timestamps have only second precision. */
+static int
+password_file_changed(int original)
+{
+    struct stat before, after;
+    int edited = open(tempname, O_RDONLY | O_NOFOLLOW);
+    if (edited == -1 || fstat(original, &before) == -1 || fstat(edited, &after) == -1)
+        pw_error(tempname, 1, 1);
+    int changed = before.st_size != after.st_size;
+    if (!changed && before.st_size != 0) {
+        void *left = mmap(NULL, before.st_size, PROT_READ, MAP_PRIVATE, original, 0);
+        void *right = mmap(NULL, after.st_size, PROT_READ, MAP_PRIVATE, edited, 0);
+        if (left == MAP_FAILED || right == MAP_FAILED)
+            pw_error(tempname, 1, 1);
+        changed = memcmp(left, right, before.st_size) != 0;
+        munmap(left, before.st_size);
+        munmap(right, after.st_size);
+    }
+    close(edited);
+    return changed;
+}
