 	}
 
 	// Move the temporary file into place.
-	if (fclose(tfp) != 0 || rename(tempname, path) != 0) {
+	if (ferror(tfp) || fflush(tfp) != 0 || fsync(fd) != 0 || fclose(tfp) != 0 || rename(tempname, path) != 0) {
 		int save = errno;
 		unlink(tempname);
 		errno = save;
 		err(EXIT_FAILURE, "%s", tempname);
 	}
 
+	char *parent = strdup(path);
+	if (parent == NULL)
+		err(EXIT_FAILURE, "strdup");
+	int parent_fd = open(dirname(parent), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (parent_fd == -1 || fsync(parent_fd) == -1)
+		err(EXIT_FAILURE, "sync password directory");
