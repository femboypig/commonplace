+/* Reject unsupported external journals before the kernel replay request. */
+static int
+has_external_journal(const char *dev)
+{
+    unsigned char block[512];
+    HFSPlusVolumeHeader header;
+    int fd = open(dev, O_RDONLY);
+    int external = 0;
+    if (fd < 0)
+        return 0;
+    if (pread(fd, block, sizeof(block), 1024) == sizeof(block)) {
+        memcpy(&header, block, sizeof(header));
+        unsigned signature = OSSwapBigToHostInt16(header.signature);
+        if ((signature == kHFSPlusSigWord || signature == kHFSXSigWord) &&
+            (OSSwapBigToHostInt32(header.attributes) & kHFSVolumeJournaledMask)) {
+            off_t offset = (uint64_t)OSSwapBigToHostInt32(header.journalInfoBlock) *
+                          OSSwapBigToHostInt32(header.blockSize);
+            if (offset > 0 && pread(fd, block, sizeof(block), offset) == sizeof(block)) {
+                uint32_t flags;
+                memcpy(&flags, block, sizeof(flags));
+                external = !!(OSSwapBigToHostInt32(flags) & kJIJournalOnOtherDeviceMask);
+            }
+        }
+    }
+    close(fd);
+    return external;
+}
